{
  "manifest_version": 3,
  "name": "T0-Local Summarizer and Translator",
  "version": "0.1.0",
  "description": "On-device summarization with Gemini Nano + client-side translation.",
  "permissions": ["activeTab", "scripting","clipboardWrite"],
  "icons":{
    "16":"icons/icon16.png",
    "32":"icons/icon32.png",
    "48":"icons/icon48.png",
    "128":"icons/icon128.png"
  },
  "action": { "default_popup": "popup.html","default_icon":{"16":"icons/icon16.png","32":"icons/icon32.png"} },
  "host_permissions": ["<all_urls>"],  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
